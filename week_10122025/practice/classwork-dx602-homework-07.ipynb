    "def f12(vs):\n",
    "    return [v for (i,v) in enumerate(vs) if i >= 5]\n",
    "\n",
    "\n",
    "def g12(n):\n",
    "    for i in range(n):\n",
    "        yield i ** 2\n",
    "\n",
    "print(f12(g12(10)))"
   ]
  }
